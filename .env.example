# Copy to .env and adjust before `docker compose up`.

# Postgres password used by both the db and api services.
POSTGRES_PASSWORD=trashscan

# Set to 1 to load development seed data (a lab CIDR, one scanner, one target).
# Leave at 0 for a clean first-run setup you drive through the UI.
RUN_SEED=0

# Seed credentials (only used when RUN_SEED=1). Change these.
TRASHSCAN_SEED_ADMIN=admin
TRASHSCAN_SEED_ADMIN_PASSWORD=change-me-admin-123
TRASHSCAN_SEED_SCANNER=scanner
TRASHSCAN_SEED_SCANNER_PASSWORD=change-me-scanner-123
TRASHSCAN_SEED_CIDR=10.10.0.0/16
TRASHSCAN_SEED_TARGET=10.10.5.20
