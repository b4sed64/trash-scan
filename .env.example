# Copy to .env and adjust before `docker compose up`.
# These are the keys docker-compose.yml interpolates. The full environment-variable
# reference (defaults, when to change each) is in docs/CONFIGURATION.md.

# Postgres password used by both the db and api services.
POSTGRES_PASSWORD=trashscan

# Set to 1 to load development seed data (a lab CIDR, one scanner, one target).
# Leave at 0 for a clean first-run setup you drive through the UI.
RUN_SEED=0

# Scanner mode: "real" runs the pinned Subfinder/dnsx binaries; "fake" uses
# deterministic stub adapters (offline development).
SCANNER_MODE=real

# Comma-separated internal DNS resolvers for the lab (optional; blank = system).
DNS_RESOLVERS=

# SYN scan, OS detection, and UDP scan (which also enables the SNMP/NetBIOS NSE
# scripts) all need raw-packet capability. Keep this false until the Phase 0
# network spike proves the minimum Docker capability; then also add
# `cap_add: [NET_RAW]` to the worker service in docker-compose.yml.
# TRASHSCAN_ALLOW_RAW_PACKET is read by the api/worker containers.

# Passive scans of a domain target can also query crt.sh (Certificate Transparency
# logs) and RDAP (WHOIS) for extra subdomains and a domain-registration-expiry
# finding. Unlike the rest of the tool bundle this sends the target's domain name
# to a third-party public service at scan time. Off by default; set to 1 to opt in.
ENABLE_EXTERNAL_OSINT=0

# Minimal seed credentials (only used when RUN_SEED=1). Change these.
TRASHSCAN_SEED_ADMIN=admin
TRASHSCAN_SEED_ADMIN_PASSWORD=change-me-admin-123
TRASHSCAN_SEED_SCANNER=scanner
TRASHSCAN_SEED_SCANNER_PASSWORD=change-me-scanner-123
TRASHSCAN_SEED_CIDR=10.10.0.0/16
TRASHSCAN_SEED_TARGET=10.10.5.20

# scripts/demo_seed.sh (the fuller demo scenario) reads these instead.
DEMO_ADMIN_PW=demo-admin-12345
DEMO_SCANNER_PW=demo-scanner-12345
